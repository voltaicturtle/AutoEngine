// Sample augments: lasting, team-wide modifiers a player picks in a choice round.
[
    (id: "war_chest", name: "War Chest", description: "Gain 12 gold now.", gold: 12),
    (
        id: "iron_discipline",
        name: "Iron Discipline",
        description: "Your team gains 15 armor and magic resist.",
        bonuses: [(scope: Team, mods: [(stat: Armor, flat: 15), (stat: MagicResist, flat: 15)])],
    ),
    (
        id: "blood_pact",
        name: "Blood Pact",
        description: "Your team heals for 10% of the damage it deals.",
        bonuses: [(scope: Team, mods: [(stat: Lifesteal, flat: 100)])],
    ),
    (
        id: "quickening",
        name: "Quickening",
        description: "Your team attacks 12% faster.",
        bonuses: [(scope: Team, mods: [(stat: AttackSpeed, permille: 120)])],
    ),
    (
        id: "tidal_surge",
        name: "Tidal Surge",
        description: "Tide units gain 40 ability power.",
        bonuses: [(scope: WithTrait("tide"), mods: [(stat: AbilityPower, flat: 40)])],
    ),
    (
        id: "second_breath",
        name: "Second Breath",
        description: "The first time each of your units drops below 30% health, it heals 20% of its maximum.",
        bonuses: [
            (
                scope: Team,
                passives: [
                    (
                        name: "Second Breath",
                        trigger: HealthBelow(permille: 300),
                        effects: [
                            (
                                target: Source,
                                effect: Heal(amount: (scalings: [(who: Source, by: Stat(MaxHealth), permille: 200)])),
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
    (
        id: "opening_gambit",
        name: "Opening Gambit",
        description: "Your team starts each fight with a 150 shield for 6 seconds.",
        bonuses: [
            (
                scope: Team,
                passives: [
                    (
                        name: "Opening Gambit",
                        trigger: CombatStart,
                        effects: [(target: Source, effect: Shield(amount: (flat: 150), duration_ms: 6000))],
                    ),
                ],
            ),
        ],
    ),
]
