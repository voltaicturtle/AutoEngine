// Fights with an expected result, run by `autoengine test`. They pin down
// what the content is supposed to do, so a later change that breaks it is
// caught. Each test is fought `runs` times with different dice.
//
// Expectations: Winner(team), WinsAtLeast(team: 0, percent: 60), Draw,
// LastsAtMost(seconds: 30), LastsAtLeast(seconds: 5), Survives(team, "unit"),
// Dies(team, "unit"), Casts(team, "unit"). Teams are numbered from 0.
(
    tests: [
        (
            name: "two stars beat one star",
            runs: 10,
            teams: [
                (units: [(unit: "ironbark_warden", star: 2, pos: (3, 4))]),
                (units: [(unit: "ironbark_warden", pos: (3, 4))]),
            ],
            expect: [Winner(0), Survives(0, "ironbark_warden")],
        ),
        (
            name: "a mender keeps its front line alive against a golem",
            runs: 5,
            teams: [
                (units: [(unit: "ironbark_warden", pos: (3, 4)), (unit: "dawnpetal_mender", pos: (3, 7))]),
                (units: [(unit: "moss_golem", star: 2, pos: (3, 4))]),
            ],
            expect: [Winner(0), Casts(0, "dawnpetal_mender"), Dies(1, "moss_golem"), LastsAtMost(seconds: 45)],
        ),
        (
            name: "three cinder units out-fight three without the trait bonus",
            runs: 20,
            teams: [
                (units: [
                    (unit: "emberlash_duelist", items: ["cinder_blade"], pos: (2, 4)),
                    (unit: "ashen_hound", pos: (3, 4)),
                    (unit: "ashen_hound", star: 2, pos: (4, 4)),
                ]),
                (units: [
                    (unit: "emberlash_duelist", pos: (2, 4)),
                    (unit: "reed_stalker", pos: (3, 4)),
                    (unit: "reed_stalker", star: 2, pos: (4, 4)),
                ]),
            ],
            expect: [WinsAtLeast(team: 0, percent: 60)],
        ),
    ],
)
