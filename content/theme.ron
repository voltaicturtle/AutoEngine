// The look of the client. Everything here is optional: delete a line to get
// the built-in value back. The client reloads this file while it runs, so
// edit, save and watch.
(
    // Interface and board colours, as #rrggbb or #rrggbbaa.
    colors: {
        "background": "#12141c",
        "panel": "#1f2430",
        "panel_light": "#2e3647",
        "text": "#e6ebf5",
        "muted": "#949eb3",
        "gold": "#facc40",
        "good": "#59d173",
        "bad": "#eb5454",
        "accent": "#599efa",
        // Rings under your units and under the opponent's.
        "friend": "#599efa",
        "enemy": "#eb5454",
        "shadow": "#00000061",
        // The board: plain tiles, your half, and the tile under a dragged unit.
        "tile": "#30384a",
        "tile_own": "#3d4f6e",
        "tile_highlight": "#739ed9",
        "bench": "#292e3d",
    },

    // One light for the whole scene. `direction` points from the board
    // towards the light; the percentages set how bright shaded and lit
    // sides are.
    light: (direction: (35, 85, 40), ambient_percent: 50, diffuse_percent: 62),

    // Particle effects: hit_physical, hit_magic, hit_true, heal, cast, death.
    //   count            how many particles
    //   color            their colour
    //   speed_percent    top speed, 100 = one hex radius per second
    //   life_ms          how long the longest-lived one lasts
    //   size_percent     100 = one hex radius across
    //   gravity_percent  how hard they fall; negative floats upwards
    effects: {
        "hit_physical": (count: 7, color: "#ff9940", speed_percent: 240, life_ms: 450, size_percent: 13, gravity_percent: 600),
        "hit_magic": (count: 7, color: "#80a6ff", speed_percent: 240, life_ms: 450, size_percent: 13, gravity_percent: 600),
        "hit_true": (count: 7, color: "#ffffff", speed_percent: 240, life_ms: 450, size_percent: 13, gravity_percent: 600),
        "heal": (count: 9, color: "#73ff8c", speed_percent: 90, life_ms: 900, size_percent: 12, gravity_percent: -250),
        "cast": (count: 22, color: "#80c7ff", speed_percent: 260, life_ms: 600, size_percent: 14, gravity_percent: 0),
        "death": (count: 26, color: "#bfbfcce6", speed_percent: 150, life_ms: 900, size_percent: 20, gravity_percent: -80),
    },
    // Critical hits throw this many particles compared to a normal hit.
    crit_percent: 230,
    // Colour of the bolt a ranged attack fires.
    bolt: "#ffd973",

    // A TrueType font for all text, relative to this folder, for example
    //   font: "fonts/MyFont.ttf",
)
