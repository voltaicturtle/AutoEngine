// The round schedule. Each round names a kind:
//   Pvp     players are paired off and fight
//   Pve     everyone fights the listed neutral board for rewards
//   Draft   a shared pool of units is offered; lowest health picks first
//   Choice  each player picks one of several augments or items
//   Custom  a round type registered by the game's own code
// When the list ends it loops from `repeat_from`, one stage higher each time,
// so losses hurt more the longer the game goes on.
(
    repeat_from: 9,
    rounds: [
        (name: "1-1", stage: 1, kind: Pve(enemies: [(unit: "moss_golem", pos: (3, 4))], items: 1)),
        (name: "1-2", stage: 1, kind: Pve(
            enemies: [(unit: "moss_golem", pos: (2, 4)), (unit: "moss_golem", pos: (4, 4))],
            gold: 1,
            items: 1,
        )),
        (name: "1-3", stage: 1, kind: Pvp),
        (name: "2-1", stage: 2, kind: Choice(options: 3, offer: Augments)),
        (name: "2-2", stage: 2, kind: Pvp),
        (name: "2-3", stage: 2, kind: Pvp),
        (name: "2-4", stage: 2, kind: Draft(extra: 1, max_cost: 2)),
        (name: "2-5", stage: 2, kind: Pvp),
        (name: "2-6", stage: 2, kind: Pve(
            enemies: [
                (unit: "moss_golem", star: 2, pos: (2, 4)),
                (unit: "moss_golem", star: 2, pos: (4, 4)),
                (unit: "grave_wisp", star: 2, pos: (3, 6)),
            ],
            gold: 3,
            items: 1,
        )),
        (name: "3-1", stage: 3, kind: Pvp),
        (name: "3-2", stage: 3, kind: Choice(options: 3, offer: Augments)),
        (name: "3-3", stage: 3, kind: Pvp),
        (name: "3-4", stage: 3, kind: Draft(extra: 1)),
        (name: "3-5", stage: 3, kind: Pvp),
        (name: "3-6", stage: 3, kind: Choice(options: 3, offer: Items)),
        (name: "3-7", stage: 3, kind: Pvp),
    ],
)
