// The round schedule. Each round has a kind:
//   Pvp     players are paired off and fight
//   Pve     everyone fights the listed neutral board for rewards
//   Draft   a shared pool of units is offered; lowest health picks first
//   Choice  each player picks one of several augments or items
//   Custom  a round type from a script in scripts/ (the file name is the kind)
// When the list ends it loops from `repeat_from`, one stage higher each time.
(
    repeat_from: 2,
    rounds: [
        (name: "1-1", stage: 1, kind: Pve(enemies: [(unit: "training_dummy", pos: (3, 4))], items: 1)),
        (name: "1-2", stage: 1, kind: Choice(options: 2, offer: Augments)),
        (name: "1-3", stage: 1, kind: Pvp),
        (name: "1-4", stage: 1, kind: Pvp),
        (name: "1-5", stage: 1, kind: Custom(kind: "bonus_gold", params: {"gold": 3})),
        (name: "1-6", stage: 1, kind: Pvp),
    ],
)
