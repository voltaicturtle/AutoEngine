// Global rules. Anything left out uses the engine default, including the
// economy, level costs and shop odds.
(
    board_cols: 7,
    board_rows: 8,
    max_items_per_unit: 3,
    // Bonus stats per star level, starting at one star.
    star_levels: [
        [],
        [(stat: MaxHealth, permille: 800), (stat: AttackDamage, permille: 500), (stat: AbilityPower, permille: 500)],
        [(stat: MaxHealth, permille: 2240), (stat: AttackDamage, permille: 1250), (stat: AbilityPower, permille: 1250)],
    ],
)
