// Units. Each entry is one unit players can buy, or one that only appears
// in neutral fights (in_shop: false).
//
// Only `id` and `name` are required. Stats you leave out use the engine's
// defaults. Speeds and percentages are whole numbers: AttackSpeed 700 means
// 0.7 attacks per second, and permille values are thousandths.
//
// After changing this file run `autoengine check` to catch mistakes and
// `autoengine test` to run the fights in tests.ron.
[
    // A front-line unit: lots of health, short range.
    (
        id: "shield_bearer",
        name: "Shield Bearer",
        cost: 1,
        traits: ["guard"],
        stats: { MaxHealth: 800, AttackDamage: 40, Armor: 35, MagicResist: 20, AttackSpeed: 600, MaxMana: 80 },
        // An ability is cast when mana is full. It is a list of effects,
        // each with a target.
        ability: (
            name: "Brace",
            cast_time_ms: 300,
            effects: [
                (target: Source, effect: Shield(amount: (flat: 250), duration_ms: 4000)),
            ],
        ),
    ),
    // A ranged damage dealer.
    (
        id: "longbow",
        name: "Longbow",
        cost: 1,
        traits: ["ranger"],
        stats: { MaxHealth: 480, AttackDamage: 55, Range: 4, AttackSpeed: 800, MaxMana: 40 },
        ability: (
            name: "Aimed Shot",
            cast_time_ms: 400,
            effects: [
                (target: CurrentTarget, effect: Damage(amount: (flat: 220, power_scaled: true), kind: Physical)),
            ],
        ),
    ),
    // A healer that belongs to both traits.
    (
        id: "field_medic",
        name: "Field Medic",
        cost: 2,
        traits: ["guard", "ranger"],
        stats: { MaxHealth: 550, AttackDamage: 35, Range: 3, MaxMana: 70 },
        ability: (
            name: "Patch Up",
            cast_time_ms: 400,
            effects: [
                (target: LowestHealthAllies(1), effect: Heal(amount: (flat: 200, power_scaled: true))),
            ],
        ),
    ),
    // Not sold in the shop: this one is only used by the neutral round.
    (
        id: "training_dummy",
        name: "Training Dummy",
        in_shop: false,
        stats: { MaxHealth: 500, AttackDamage: 25, AttackSpeed: 500 },
    ),
]
